# Environment & Server Config
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database Connection (MySQL)
DATABASE_URL="mysql://root:password@localhost:3306/mobile_accessories_db"

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_super_secret_access_key_mobile_accessories_2026
JWT_REFRESH_SECRET=your_super_secret_refresh_key_mobile_accessories_2026
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cryptographic Encryption Key for Payment Secrets (32 characters / 256 bits)
ENCRYPTION_KEY=12345678901234567890123456789012

# File Upload Configuration
UPLOAD_PROVIDER=local
UPLOAD_PATH=./src/uploads

# Nodemailer / SMTP Configuration (Development Mocking supported)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mock_user
SMTP_PASSWORD=mock_pass
EMAIL_FROM="Mobile Accessories Store <noreply@accessories.com>"

# Default Super Admin Seed Credentials
DEFAULT_ADMIN_NAME="Super Admin"
DEFAULT_ADMIN_EMAIL=superadmin@accessories.com
DEFAULT_ADMIN_PASSWORD=SuperAdmin123!
DEFAULT_ADMIN_MOBILE=9876543210

# Default Admin Seed Credentials
DEFAULT_STAFF_EMAIL=admin@accessories.com
DEFAULT_STAFF_PASSWORD=Admin123!

# Razorpay Configuration (Test Credentials - Super Admin can configure encrypted keys via Admin UI)
RAZORPAY_KEY_ID=rzp_test_key_id_12345
RAZORPAY_KEY_SECRET=rzp_test_secret_67890
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret_9999
